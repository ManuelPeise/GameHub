# Copy to docker/testing.env (ignored by git) and fill in.
POSTGRES_PASSWORD=change-me
# Port of the app on this computer and the address used in e-mail links.
APP_PORT=8081
PUBLIC_BASE_URL=http://localhost:8081
# Mailpit web UI (all e-mails of Testing end up here).
MAIL_UI_PORT=8026
# Image: latest from GitHub (ghcr.io) or a specific commit (sha-<short>).
GAMEHUB_TAG=latest
