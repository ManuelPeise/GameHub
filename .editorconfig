# =====================================================================
# GameHub – Editor-Einstellungen (Visual Studio, Rider, VS Code)
# Ergänzt .gitattributes: Editoren schreiben gleich LF, Git muss nichts
# konvertieren.
# =====================================================================
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cmd,bat,sln}]
end_of_line = crlf

[*.{json,yaml,yml,ts,tsx,js,jsx,css,html,csproj,props,targets,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
